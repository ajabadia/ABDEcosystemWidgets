{
    "name": "@abd/ecosystem-widgets",
    "version": "1.0.0",
    "type": "module",
    "description": "Smart components and widgets for ABD Suite Ecosystem.",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
